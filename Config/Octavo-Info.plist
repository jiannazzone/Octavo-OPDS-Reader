<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!--
  Keys merged into the app's generated Info.plist (INFOPLIST_FILE with
  GENERATE_INFOPLIST_FILE = YES). Only keys that INFOPLIST_KEY_* build
  settings can't express belong here. Kept outside the folder-synchronized
  Octavo/ group so it isn't copied into the bundle as a resource.
-->
<plist version="1.0">
<dict>
	<!--
	  Import from Files and Open in Octavo (step 15, docs/notes/other-ways-in.md):
	  the books Octavo reads, offered in the Files picker and in other apps'
	  share sheets. iOS copies a shared file into Documents/Inbox (not opened
	  in place); the app checks its bytes, keeps a copy in ImportedBooks and
	  deletes the inbox copy. Nobody declares MOBI, AZW3 or FB2 system-wide, so
	  they're imported here under Octavo's own identifiers.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Kindle book</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ianazzone.ereader.mobi</string>
				<string>com.ianazzone.ereader.azw3</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>FictionBook</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.ianazzone.ereader.fb2</string>
				<string>com.ianazzone.ereader.fbz</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ianazzone.ereader.mobi</string>
			<key>UTTypeDescription</key>
			<string>Kindle book (MOBI)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mobi</string>
					<string>azw</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-mobipocket-ebook</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ianazzone.ereader.azw3</string>
			<key>UTTypeDescription</key>
			<string>Kindle book (AZW3)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>azw3</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.amazon.mobi8-ebook</string>
					<string>application/x-mobi8-ebook</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ianazzone.ereader.fb2</string>
			<key>UTTypeDescription</key>
			<string>FictionBook</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fb2</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-fictionbook+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.ianazzone.ereader.fbz</string>
			<key>UTTypeDescription</key>
			<string>FictionBook (zipped)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fbz</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-zip-compressed-fb2</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  Plain http and self-signed certificates only for home and VPN
		  addresses (D25, docs/notes/network-trust.md). ATS is the outer
		  fence; OctavoKit's HomeNetworkPolicy checks every request inside it
		  (and catches what ATS misses, like http://16843009/).
		  NSAllowsLocalNetworking: home-range IP addresses (RFC 1918,
		  loopback, link-local, IPv6 ULA and link-local), names without dots
		  and .local.
		-->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- RFC 6598 shared address space: Tailscale's addresses. -->
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- Special-use home names. Keep in step with
			     HomeNetworkPolicy.localSuffixes. -->
			<key>home.arpa</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>internal</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>lan</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- Tailscale MagicDNS names (WireGuard-encrypted underneath). -->
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
