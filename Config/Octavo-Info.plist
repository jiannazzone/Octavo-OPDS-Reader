<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!--
  Keys merged into the app's generated Info.plist (INFOPLIST_FILE with
  GENERATE_INFOPLIST_FILE = YES). Only keys that INFOPLIST_KEY_* build
  settings can't express belong here. Kept outside the folder-synchronized
  Octavo/ group so it isn't copied into the bundle as a resource.
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  Plain http and self-signed certificates only for home and VPN
		  addresses (D25, docs/notes/network-trust.md). ATS is the outer
		  fence; OctavoKit's HomeNetworkPolicy checks every request inside it
		  (and catches what ATS misses, like http://16843009/).
		  NSAllowsLocalNetworking: home-range IP addresses (RFC 1918,
		  loopback, link-local, IPv6 ULA and link-local), names without dots
		  and .local.
		-->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<!-- RFC 6598 shared address space: Tailscale's addresses. -->
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- Special-use home names. Keep in step with
			     HomeNetworkPolicy.localSuffixes. -->
			<key>home.arpa</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>internal</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>lan</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<!-- Tailscale MagicDNS names (WireGuard-encrypted underneath). -->
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
